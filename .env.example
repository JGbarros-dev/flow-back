PORT=4000
# Troque em produção (assinatura dos tokens de sessão e chave AES dos documentos fiscais).
TOKEN_SECRET=troque-por-um-segredo-longo
DOC_KEY=troque-por-outra-chave-longa
# Origem do frontend (separe várias por vírgula). Sem valor: aceita qualquer origem.
CORS_ORIGIN=
# Velocidade inicial da simulação (10 = 1 minuto real vale 10 minutos da operação).
SIM_VELOCIDADE=10
